build/artifacts/*
!build/artifacts/*.json

# Virtual environments
.venv/
venv/

# Local environment files
.env
.env.*
!.env.example

# IDE and operating-system files
.idea/
.vscode/
*.code-workspace
.DS_Store
Thumbs.db
