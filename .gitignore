# Python bytecode and test caches
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-cache-files-*/
pytest-cache-files-*/
.pytest-step*/
tmp*/
temp*/
*.tmp

# Runtime audit output
audit/

